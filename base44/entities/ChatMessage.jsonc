{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "receiver_email": {
      "type": "string",
      "description": "Email of the receiver"
    },
    "conversation_id": {
      "type": "string",
      "description": "Unique conversation ID between patient and doctor"
    },
    "message": {
      "type": "string",
      "description": "Text message content"
    },
    "image_url": {
      "type": "string",
      "description": "URL of uploaded image (food photo etc)"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of uploaded voice message"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "text_image",
        "audio"
      ],
      "description": "Type of message"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read by the receiver"
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "conversation_id",
    "message_type"
  ]
}