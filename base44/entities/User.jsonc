{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "patient",
        "doctor",
        "admin"
      ],
      "default": "patient"
    },
    "phone": {
      "type": "string",
      "description": "Mobile phone number"
    },
    "age": {
      "type": "number",
      "description": "Age of the user"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "patient_id": {
      "type": "string",
      "description": "Unique patient ID"
    },
    "specialty": {
      "type": "string",
      "description": "Doctor's medical specialty"
    },
    "city": {
      "type": "string",
      "description": "Doctor's city"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "phone",
    "age",
    "gender",
    "patient_id"
  ]
}