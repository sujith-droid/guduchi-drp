{
  "name": "PatientDoctorAssignment",
  "type": "object",
  "properties": {
    "patient_email": {
      "type": "string",
      "description": "Email of the patient"
    },
    "doctor_email": {
      "type": "string",
      "description": "Email of the assigned doctor"
    },
    "patient_name": {
      "type": "string",
      "description": "Display name of patient"
    },
    "doctor_name": {
      "type": "string",
      "description": "Display name of doctor"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "program_duration": {
      "type": "string",
      "enum": [
        "1 month",
        "3 months",
        "6 months",
        "9 months"
      ],
      "description": "Program duration selected for the patient"
    },
    "patient_id": {
      "type": "string",
      "description": "Patient ID assigned by the doctor"
    }
  },
  "required": [
    "patient_email",
    "doctor_email"
  ]
}